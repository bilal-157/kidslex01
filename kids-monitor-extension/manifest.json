{
  "manifest_version": 3,

  "name": "Test Extension",
  "version": "1.0",

  "permissions": ["history", "geolocation", "storage", "notifications", "tabs", "scripting"],

  "host_permissions": [
    "http://localhost:3000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["welcome.html", "welcome.js"],
      "matches": ["<all_urls>"]
    }
  ]
}